<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/next_prayer_widget_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:layoutDirection="rtl"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <!-- Right Column: Info (Prayer Name + Subtitle) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Line 1: اسم الصلاة (Large, Bold, High Contrast) -->
        <TextView
            android:id="@+id/next_prayer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/notif_seamless_title"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="صلاة الفجر" />

        <!-- Line 2: الوصف التوضيحي الهادئ الواضح -->
        <TextView
            android:id="@+id/next_prayer_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/notif_seamless_sub"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="الصلاة القادمة • متبقي 5س 05د" />
    </LinearLayout>

    <!-- Left Column: Pure Typography Time (Clean, Bold, No Box, Easy on Eyes) -->
    <TextView
        android:id="@+id/next_prayer_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="@color/notif_seamless_badge_text"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:text="04:52 ص" />

</LinearLayout>
