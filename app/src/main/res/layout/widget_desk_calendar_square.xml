<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_desk_calendar_square_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nateega_bg_classic"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/desk_cal_month_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginEnd="6dp"
            android:textColor="#1E3A8A"
            android:textSize="11.5sp"
            android:textStyle="bold"
            tools:text="السبت، ١٦ نوفمبر ٢٠٢٦" />

        <TextClock
            android:id="@+id/desk_cal_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/nateega_capsule_classic"
            android:format12Hour="hh:mm a"
            android:format24Hour="HH:mm"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#1E3A8A"
            android:textSize="10.5sp"
            android:textStyle="bold"
            tools:text="10:30 م" />
    </LinearLayout>

    <!-- Countdown Strip Banner -->
    <LinearLayout
        android:id="@+id/desk_cal_countdown_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/nateega_capsule_classic"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2.5dp"
        android:paddingBottom="2.5dp">

        <TextView
            android:id="@+id/desk_cal_countdown_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#1E3A8A"
            android:textSize="10.5sp"
            android:textStyle="bold"
            tools:text="⏳ الصلاة القادمة: المغرب" />

        <Chronometer
            android:id="@+id/desk_cal_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:countDown="true"
            android:enabled="false"
            android:textColor="#059669"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Calendar Matrix Image (Takes center stage in square) -->
    <ImageView
        android:id="@+id/desk_cal_grid_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:contentDescription="Calendar Matrix" />

    <!-- Nateega-style 6-Slot Prayer Times Row -->
    <LinearLayout
        android:id="@+id/desk_cal_prayers_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/nateega_table_bg_classic"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="3dp">

        <!-- Fajr -->
        <LinearLayout
            android:id="@+id/desk_cal_row_fajr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2.5dp"
            android:paddingBottom="2.5dp">
            <TextView
                android:id="@+id/desk_cal_lbl_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text="الفجر"
                android:textColor="#64748B"
                android:textSize="8.5sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/desk_cal_time_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:textColor="#1E3A8A"
                android:textSize="9.5sp"
                android:textStyle="bold"
                tools:text="05:02" />
        </LinearLayout>

        <!-- Sunrise -->
        <LinearLayout
            android:id="@+id/desk_cal_row_sunrise"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2.5dp"
            android:paddingBottom="2.5dp">
            <TextView
                android:id="@+id/desk_cal_lbl_sunrise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text="الشروق"
                android:textColor="#64748B"
                android:textSize="8.5sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/desk_cal_time_sunrise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:textColor="#1E3A8A"
                android:textSize="9.5sp"
                android:textStyle="bold"
                tools:text="06:22" />
        </LinearLayout>

        <!-- Dhuhr -->
        <LinearLayout
            android:id="@+id/desk_cal_row_dhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2.5dp"
            android:paddingBottom="2.5dp">
            <TextView
                android:id="@+id/desk_cal_lbl_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text="الظهر"
                android:textColor="#64748B"
                android:textSize="8.5sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/desk_cal_time_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:textColor="#1E3A8A"
                android:textSize="9.5sp"
                android:textStyle="bold"
                tools:text="11:45" />
        </LinearLayout>

        <!-- Asr -->
        <LinearLayout
            android:id="@+id/desk_cal_row_asr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2.5dp"
            android:paddingBottom="2.5dp">
            <TextView
                android:id="@+id/desk_cal_lbl_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text="العصر"
                android:textColor="#64748B"
                android:textSize="8.5sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/desk_cal_time_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:textColor="#1E3A8A"
                android:textSize="9.5sp"
                android:textStyle="bold"
                tools:text="02:40" />
        </LinearLayout>

        <!-- Maghrib -->
        <LinearLayout
            android:id="@+id/desk_cal_row_maghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2.5dp"
            android:paddingBottom="2.5dp">
            <TextView
                android:id="@+id/desk_cal_lbl_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text="المغرب"
                android:textColor="#64748B"
                android:textSize="8.5sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/desk_cal_time_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:textColor="#1E3A8A"
                android:textSize="9.5sp"
                android:textStyle="bold"
                tools:text="05:01" />
        </LinearLayout>

        <!-- Isha -->
        <LinearLayout
            android:id="@+id/desk_cal_row_isha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2.5dp"
            android:paddingBottom="2.5dp">
            <TextView
                android:id="@+id/desk_cal_lbl_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text="العشاء"
                android:textColor="#64748B"
                android:textSize="8.5sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/desk_cal_time_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:textColor="#1E3A8A"
                android:textSize="9.5sp"
                android:textStyle="bold"
                tools:text="06:21" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
