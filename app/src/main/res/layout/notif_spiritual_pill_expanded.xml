<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_smart_pill_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <!-- Header Row: Full-width Title (allows 2 lines so nothing is ever cut off) -->
    <TextView
        android:id="@+id/smart_pill_expanded_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:textColor="@color/notif_seamless_title"
        android:textSize="15.5sp"
        android:textStyle="bold"
        tools:text="وقت النهي (استواء الشمس)" />

    <!-- Full Hadith / Dua Body: Complete text without any truncation -->
    <TextView
        android:id="@+id/smart_pill_expanded_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2.5dp"
        android:textColor="@color/notif_seamless_sub"
        android:textSize="13.5sp"
        tools:text="نهى النبي ﷺ عن الصلاة نصف النهار حتى تزول الشمس • استعد للوضوء وركعتي السنة القبلية والتبكير لصلاة الجماعة" />

</LinearLayout>
