<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_mosque_arch_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_square_bg_midnight"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Top Quranic Banner / Arch Header -->
    <TextView
        android:id="@+id/mosque_arch_ayah"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="﴿ إِنَّ الصَّلَاةَ كَانَتْ عَلَى الْمُؤْمِنِينَ كِتَابًا مَّوْقُوتًا ﴾"
        android:textColor="#F59E0B"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <!-- Center Next Prayer Hero -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mosque_arch_next_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            tools:text="الصلاة القادمة: المغرب" />

        <TextView
            android:id="@+id/mosque_arch_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#38BDF8"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="05:01 م" />

        <Chronometer
            android:id="@+id/mosque_arch_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/widget_chronometer_pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:countDown="true"
            android:enabled="false"
            android:textColor="#34D399"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Prayers Timetable Row -->
    <LinearLayout
        android:id="@+id/mosque_arch_prayers_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/nateega_table_bg_midnight"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <!-- Fajr -->
        <LinearLayout
            android:id="@+id/mosque_arch_slot_fajr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/mosque_arch_label_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الفجر"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/mosque_arch_time_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="05:02" />
        </LinearLayout>

        <!-- Sunrise -->
        <LinearLayout
            android:id="@+id/mosque_arch_slot_sunrise"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/mosque_arch_label_sunrise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الشروق"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/mosque_arch_time_sunrise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="06:28" />
        </LinearLayout>

        <!-- Dhuhr -->
        <LinearLayout
            android:id="@+id/mosque_arch_slot_dhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/mosque_arch_label_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الظهر"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/mosque_arch_time_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="11:45" />
        </LinearLayout>

        <!-- Asr -->
        <LinearLayout
            android:id="@+id/mosque_arch_slot_asr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/mosque_arch_label_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العصر"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/mosque_arch_time_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="02:40" />
        </LinearLayout>

        <!-- Maghrib -->
        <LinearLayout
            android:id="@+id/mosque_arch_slot_maghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/mosque_arch_label_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المغرب"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/mosque_arch_time_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="05:01" />
        </LinearLayout>

        <!-- Isha -->
        <LinearLayout
            android:id="@+id/mosque_arch_slot_isha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/mosque_arch_label_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العشاء"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/mosque_arch_time_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="06:21" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
