<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_desk_calendar_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nateega_bg_classic"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/desk_cal_month_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginEnd="6dp"
            android:textColor="#1E3A8A"
            android:textSize="12.5sp"
            android:textStyle="bold"
            tools:text="السبت، ١٦ نوفمبر ٢٠٢٦ م" />

        <TextClock
            android:id="@+id/desk_cal_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/nateega_capsule_classic"
            android:format12Hour="hh:mm a"
            android:format24Hour="HH:mm"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#1E3A8A"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="10:30 م" />
    </LinearLayout>

    <!-- Countdown Strip Banner -->
    <LinearLayout
        android:id="@+id/desk_cal_countdown_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/nateega_capsule_classic"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/desk_cal_countdown_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#1E3A8A"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="⏳ الصلاة القادمة: المغرب" />

        <Chronometer
            android:id="@+id/desk_cal_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:countDown="true"
            android:enabled="false"
            android:textColor="#059669"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Content: Calendar Grid + Prayer Times -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left: Calendar Matrix Image -->
        <ImageView
            android:id="@+id/desk_cal_grid_image"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:scaleType="fitCenter"
            android:contentDescription="Calendar Matrix" />

        <!-- Right: Prayer Times List -->
        <LinearLayout
            android:id="@+id/desk_cal_prayers_col"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Fajr -->
            <LinearLayout android:id="@+id/desk_cal_row_fajr" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="2.5dp" android:gravity="center_vertical">
                <TextView android:id="@+id/desk_cal_lbl_fajr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="الفجر" android:textSize="9.5sp" android:textColor="#475569" />
                <TextView android:id="@+id/desk_cal_time_fajr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9.5sp" android:textStyle="bold" android:textColor="#0F172A" tools:text="05:02" />
            </LinearLayout>

            <!-- Sunrise -->
            <LinearLayout android:id="@+id/desk_cal_row_sunrise" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="2.5dp" android:gravity="center_vertical">
                <TextView android:id="@+id/desk_cal_lbl_sunrise" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="الشروق" android:textSize="9.5sp" android:textColor="#475569" />
                <TextView android:id="@+id/desk_cal_time_sunrise" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9.5sp" android:textStyle="bold" android:textColor="#0F172A" tools:text="06:22" />
            </LinearLayout>

            <!-- Dhuhr -->
            <LinearLayout android:id="@+id/desk_cal_row_dhuhr" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="2.5dp" android:gravity="center_vertical">
                <TextView android:id="@+id/desk_cal_lbl_dhuhr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="الظهر" android:textSize="9.5sp" android:textColor="#475569" />
                <TextView android:id="@+id/desk_cal_time_dhuhr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9.5sp" android:textStyle="bold" android:textColor="#0F172A" tools:text="11:45" />
            </LinearLayout>

            <!-- Asr -->
            <LinearLayout android:id="@+id/desk_cal_row_asr" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="2.5dp" android:gravity="center_vertical">
                <TextView android:id="@+id/desk_cal_lbl_asr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="العصر" android:textSize="9.5sp" android:textColor="#475569" />
                <TextView android:id="@+id/desk_cal_time_asr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9.5sp" android:textStyle="bold" android:textColor="#0F172A" tools:text="02:40" />
            </LinearLayout>

            <!-- Maghrib -->
            <LinearLayout android:id="@+id/desk_cal_row_maghrib" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="2.5dp" android:gravity="center_vertical">
                <TextView android:id="@+id/desk_cal_lbl_maghrib" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="المغرب" android:textSize="9.5sp" android:textColor="#475569" />
                <TextView android:id="@+id/desk_cal_time_maghrib" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9.5sp" android:textStyle="bold" android:textColor="#0F172A" tools:text="05:01" />
            </LinearLayout>

            <!-- Isha -->
            <LinearLayout android:id="@+id/desk_cal_row_isha" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="2.5dp" android:gravity="center_vertical">
                <TextView android:id="@+id/desk_cal_lbl_isha" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="العشاء" android:textSize="9.5sp" android:textColor="#475569" />
                <TextView android:id="@+id/desk_cal_time_isha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9.5sp" android:textStyle="bold" android:textColor="#0F172A" tools:text="06:21" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
