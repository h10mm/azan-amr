<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nateega_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nateega_bg_amoled"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="3dp"
    android:paddingBottom="2dp">

    <!-- Top Header: Supports CenterLarge, or Split Side (Day on Right, Clock on Left) -->
    <LinearLayout
        android:id="@+id/nateega_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. Center Large Mode: Day as Heritage Title on Top, with Sub-Capsule below -->
        <LinearLayout
            android:id="@+id/nateega_clock_center_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:id="@+id/nateega_day_ar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/nateega_center_sub_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1.5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/nateega_day_en"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/nateega_capsule_dark"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="1dp"
                    android:textColor="#A3A3A3"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextClock
                    android:id="@+id/nateega_clock_center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:format12Hour="h:mm a"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#76D5D8"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. Split Side Mode: Day on Right (Start), Clock on Left (End) -->
        <LinearLayout
            android:id="@+id/nateega_split_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:visibility="gone">

            <!-- Day Info (Right side / Start in RTL) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nateega_day_ar_split"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/nateega_day_en_split"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:background="@drawable/nateega_capsule_dark"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="1dp"
                    android:textColor="#A3A3A3"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Clock (Left side / End in RTL) -->
            <TextClock
                android:id="@+id/nateega_clock_split"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:gravity="end|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#EAB308"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top Divider -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:layout_marginTop="1.5dp"
        android:background="#262626" />

    <!-- Flexible Spacer 1 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Two Main Columns: Gregorian (Left) & Hijri (Right) -->
    <LinearLayout
        android:id="@+id/nateega_dates_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Gregorian Side -->
        <LinearLayout
            android:id="@+id/nateega_greg_col"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="1dp">

            <TextView
                android:id="@+id/nateega_greg_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nateega_greg_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#E5E5E5"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nateega_greg_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#737373"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Vertical Divider -->
        <FrameLayout
            android:id="@+id/nateega_dates_divider"
            android:layout_width="1.5dp"
            android:layout_height="match_parent"
            android:layout_marginVertical="4dp"
            android:background="#262626" />

        <!-- Hijri Side -->
        <LinearLayout
            android:id="@+id/nateega_hijri_col"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="1dp">

            <TextView
                android:id="@+id/nateega_hijri_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nateega_hijri_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#E5E5E5"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nateega_hijri_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#737373"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Flexible Spacer 2 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Sub Bar: Centered Coptic Box + Gregorian Summary -->
    <LinearLayout
        android:id="@+id/nateega_sub_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Coptic Date Stamp Box (Locked in Center) -->
        <LinearLayout
            android:id="@+id/nateega_coptic_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/nateega_capsule_dark"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingVertical="1.5dp">

            <TextView
                android:id="@+id/nateega_coptic_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/nateega_greg_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#A3A3A3"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Flexible Spacer 3 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Countdown & Next Prayer Progress Section -->
    <LinearLayout
        android:id="@+id/nateega_countdown_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/nateega_countdown_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <TextView
                android:id="@+id/nateega_next_prayer_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <Chronometer
                android:id="@+id/nateega_countdown_chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FACC15"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Progress Bar for Prayer Time Elapsed -->
        <ProgressBar
            android:id="@+id/nateega_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:layout_marginTop="1dp"
            android:max="100"
            android:progress="60"
            android:progressDrawable="@drawable/nateega_progress_bar_dark" />
    </LinearLayout>

    <!-- Flexible Spacer 4 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Prayer Times Table (Click opens MonthlyView!) -->
    <LinearLayout
        android:id="@+id/nateega_prayer_table"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/nateega_table_bg_dark"
        android:clickable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp"
        android:paddingVertical="2dp">

        <!-- Fajr -->
        <LinearLayout
            android:id="@+id/nateega_slot_fajr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="1dp"
            android:paddingVertical="1.5dp">

            <TextView
                android:id="@+id/nateega_label_fajr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/fajr"
                android:textColor="#A3A3A3"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nateega_time_fajr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0.5dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Sunrise -->
        <LinearLayout
            android:id="@+id/nateega_slot_sunrise"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="1dp"
            android:paddingVertical="1.5dp">

            <TextView
                android:id="@+id/nateega_label_sunrise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/sunrise_short"
                android:textColor="#A3A3A3"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nateega_time_sunrise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0.5dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dhuhr -->
        <LinearLayout
            android:id="@+id/nateega_slot_dhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="1dp"
            android:paddingVertical="1.5dp">

            <TextView
                android:id="@+id/nateega_label_dhuhr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/dhuhr"
                android:textColor="#A3A3A3"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nateega_time_dhuhr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0.5dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Asr -->
        <LinearLayout
            android:id="@+id/nateega_slot_asr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="1dp"
            android:paddingVertical="1.5dp">

            <TextView
                android:id="@+id/nateega_label_asr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/asr"
                android:textColor="#A3A3A3"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nateega_time_asr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0.5dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Maghrib -->
        <LinearLayout
            android:id="@+id/nateega_slot_maghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="1dp"
            android:paddingVertical="1.5dp">

            <TextView
                android:id="@+id/nateega_label_maghrib"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/maghrib"
                android:textColor="#A3A3A3"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nateega_time_maghrib"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0.5dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Isha -->
        <LinearLayout
            android:id="@+id/nateega_slot_isha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="1dp"
            android:paddingVertical="1.5dp">

            <TextView
                android:id="@+id/nateega_label_isha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/isha"
                android:textColor="#A3A3A3"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nateega_time_isha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0.5dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Flexible Spacer 5 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Daily Wisdom Footer (Seamless Naskh Typography, Single Line, No Border) -->
    <LinearLayout
        android:id="@+id/nateega_wisdom_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="4dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp">

        <ImageView
            android:id="@+id/nateega_wisdom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />
    </LinearLayout>

</LinearLayout>
