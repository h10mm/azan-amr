<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.TURN_SCREEN_ON" />
    <!-- Launch the full-screen adhan alarm over the lock screen (required on Android 14+) -->
    <uses-permission
        android:name="android.permission.USE_FULL_SCREEN_INTENT"
        tools:ignore="FullScreenIntentPolicy" />

    <!--
      "Display over other apps". The only background-activity-launch exemption that doesn't expire:
      without it, "Always open the alarm screen" is silently blocked on Android 15+ (and on OEM skins
      that gate background starts behind this toggle). Optional — the full-screen intent still works.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- For Xiaomi devices to enable heads-up notifications as default (https://github.com/invertase/notifee/issues/296) -->
    <uses-permission
        android:name="android.permission.ACCESS_NOTIFICATION_POLICY"
        android:minSdkVersion="23" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- To detect incoming and active calls to not play sound -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Voice Tasbih counting via SpeechRecognizer -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Foreground service for previewing adhan audio & floating Tasbih bubble -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- this removes ACCESS_NETWORK_STATE permission added by work manager:  -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.App.Starting"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen adhan alarm; shows over the lock screen and turns the screen on. -->
        <activity
            android:name=".alarm.AlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:theme="@style/Theme.AlAzan"
            android:turnScreenOn="true" />

        <!-- Unified home screen widget configuration activity -->
        <activity
            android:name=".widget.WidgetConfigureActivity"
            android:exported="true"
            android:theme="@style/Theme.AlAzan">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- An app update invalidates our scheduled alarms; re-arm them (no missed catch-up). -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".TimeChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.ACTION_TIME_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".LocaleChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Reconciles alarms (exact <-> inexact) when exact-alarm permission is granted/revoked (API 31+),
             so scheduling is correct no matter the order the user grants permissions. -->
        <receiver
            android:name=".ExactAlarmPermissionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Fires scheduled widget-redraw + adhan alarms. The cancel filter receives the pre-alarm's
             "Cancel" action (sent targeted to this package). -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.github.meypod.al_azan.action.CANCEL_ADHAN" />
                <action android:name="com.github.meypod.al_azan.action.STOP_ADHAN_SOUND" />
                <action android:name="com.github.meypod.al_azan.action.UNSILENCE" />
                <action android:name="com.github.meypod.al_azan.action.CANCEL_REMINDER" />
                <action android:name="com.github.meypod.al_azan.action.STOP_SOFT_SOUND" />
                <action android:name="com.github.meypod.al_azan.action.RAMADAN_REMIND_NEXT_YEAR" />
                <action android:name="com.github.meypod.al_azan.action.RAMADAN_DONT_SHOW_AGAIN" />
            </intent-filter>
        </receiver>

        <!-- Plays the adhan as a foreground service when an alarm fires. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Floating draggable Tasbih bubble overlay foreground service -->
        <service
            android:name=".main.tasbih.FloatingTasbihService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating Tasbih counter bubble overlay" />
        </service>







        <!-- Dedicated circular next-prayer dial widget (قرص مواقيت الصلاة القادمة مع العداد الدائري) -->
        <receiver
            android:name=".widget.NextPrayerCircleWidget"
            android:label="قرص الصلاة القادمة (عداد دائري)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_prayer_circle_widget_info" />
        </receiver>

        <!-- Dedicated square next-prayer widget (بطاقة الصلاة القادمة المربعة مع العداد) -->
        <receiver
            android:name=".widget.NextPrayerSquareWidget"
            android:label="مواقيت الصلاة القادمة (مربع 2×2)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_prayer_square_widget_info" />
        </receiver>

        <!-- 1. Ultra-slim Header Bar (الشريط المودرن النحيف 4×1) -->
        <receiver
            android:name=".widget.SlimBarWidget"
            android:label="الشريط المودرن النحيف (4×1)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/slim_bar_widget_info" />
        </receiver>

        <!-- 2. Mosque Arch & Silhouette (محراب المسجد والقباب 4×2) -->
        <receiver
            android:name=".widget.MosqueArchWidget"
            android:label="محراب المسجد والقباب (4×2)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mosque_arch_widget_info" />
        </receiver>

        <!-- 3. Dynamic Smart Pill (الكبسولة الذكية للمواقيت 2×1) -->
        <receiver
            android:name=".widget.SmartPillWidget"
            android:label="الكبسولة الذكية للمواقيت (2×1)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/smart_pill_widget_info" />
        </receiver>

        <!-- 4. Desk Calendar (التقويم المكتبي المتطور - يتكيف تلقائياً بين الأفقي والمربع) -->
        <receiver
            android:name=".widget.DeskCalendarWidget"
            android:label="التقويم المكتبي المتطور"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/desk_calendar_widget_info" />
        </receiver>
        <!-- Daily Wall Calendar (رزمانة الحائط اليومية) -->
        <receiver
            android:name=".widget.NateegaWidget"
            android:label="رزمانة الحائط اليومية"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nateega_widget_info" />
        </receiver>

        <!-- Compact Prayer & Dates Widget (المواقيت والتقويم المدمج) -->
        <receiver
            android:name=".widget.CompactPrayerWidget"
            android:label="المواقيت والتقويم المدمج"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/compact_prayer_widget_info" />
        </receiver>

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <service
            android:name=".core.data.audio.AdhanPreviewPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- AppFunctions entry point, generated from BaseAlAzanAppFunctionService. Only the system binds it (API 36+). -->
        <service
            android:name=".appfunctions.AlAzanAppFunctionService"
            android:exported="true"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            tools:targetApi="36">
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="app_functions.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />
    </application>

</manifest>
